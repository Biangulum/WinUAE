/*
  Solution filter for the native ARM64 build of the WinUAE fork (VS2026 / MSBuild).

  Copyright 2026 Drazen Hudoletnjak

  This program is free software; you can redistribute it and/or modify
  it under the terms of the GNU General Public License version 2 as
  published by the Free Software Foundation.

  This program is distributed in the hope that it will be useful,
  but WITHOUT ANY WARRANTY; without even the implied warranty of
  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
  GNU General Public License for more details.

  Loads only the projects of upstream's winuae_msvc.sln that build for ARM64,
  so "Build Solution" works without editing upstream .sln/.vcxproj files.

  Left out on purpose:
    gencpu, gencomp, genblitter, build68k, genlinetoscr
                     ARM64 configs link with /MACHINE:I386 or /DYNAMICBASE:NO
                     and fail; genblitter also deletes blit.h, blitfunc.cpp,
                     blitfunc.h and blittable.cpp before linking. The generated
                     sources are already in the repository.
    uaeunp, cputestgen, cputester_m68k
                     compile errors in their ARM64 configs.
    resourcedll      project file is missing from the repository.
*/
{
  "solution": {
    "path": "od-win32\\winuae_msvc15\\winuae_msvc.sln",
    "projects": [
      "winuae_msvc.vcxproj",
      "..\\prowizard\\prowizard.vcxproj",
      "..\\unpackers\\unpackers.vcxproj"
    ]
  }
}
