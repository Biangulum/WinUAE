<?xml version="1.0" encoding="utf-8"?>
<!--
  Local build settings for the WinUAE fork (VS2026 / MSBuild).

  Copyright 2026 Drazen Hudoletnjak

  This program is free software; you can redistribute it and/or modify
  it under the terms of the GNU General Public License version 2 as
  published by the Free Software Foundation.

  This program is distributed in the hope that it will be useful,
  but WITHOUT ANY WARRANTY; without even the implied warranty of
  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
  GNU General Public License for more details.

  MSBuild imports this file automatically, early in every project below this
  folder. It defines the in-repo folders used instead of upstream's hardcoded
  d:\amiga and c:\dev, and registers Directory.Build.Paths.targets, which the
  C++ build imports right after the project body, so upstream .vcxproj files
  stay untouched.

    out\           built executables (upstream: d:\amiga\)
    deps\include\  third-party headers from winuaeinclibs.zip (upstream: c:\dev\include\)
    deps\lib\      third-party libraries, per architecture (upstream: c:\dev\lib\)
    deps\bin\      runtime DLLs built by deps-build\build-deps.ps1, copied to out\
-->
<Project>
  <PropertyGroup>
    <WinUAEOutDir Condition="'$(WinUAEOutDir)' == ''">$(MSBuildThisFileDirectory)out\</WinUAEOutDir>
    <WinUAEDepsDir Condition="'$(WinUAEDepsDir)' == ''">$(MSBuildThisFileDirectory)deps\</WinUAEDepsDir>
    <ForceImportBeforeCppTargets>$(MSBuildThisFileDirectory)Directory.Build.Paths.targets</ForceImportBeforeCppTargets>
  </PropertyGroup>
</Project>
