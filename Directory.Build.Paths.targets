<?xml version="1.0" encoding="utf-8"?>
<!--
  Build path redirection for the WinUAE fork.

  Copyright 2026 Drazen Hudoletnjak

  This program is free software; you can redistribute it and/or modify
  it under the terms of the GNU General Public License version 2 as
  published by the Free Software Foundation.

  This program is distributed in the hope that it will be useful,
  but WITHOUT ANY WARRANTY; without even the implied warranty of
  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
  GNU General Public License for more details.

  Imported (via ForceImportBeforeCppTargets in Directory.Build.props) after the
  project body but before the C++ targets compute TargetDir/TargetPath and the
  VC++ directories, so it can rewrite the paths upstream hardcodes:

  - d:\amiga\ output, and every configuration of the main winuae project,
    goes to $(WinUAEOutDir), so winuae.exe, winuae64.exe and winuaearm64.exe
    always end up in one place.
  - Every c:\dev\ reference (include/library paths, prowizard.lib output)
    is rewritten to $(WinUAEDepsDir), matched case-insensitively.
-->
<Project>
  <PropertyGroup>
    <_WinUAEDevPattern>(?i)c:\\dev\\</_WinUAEDevPattern>
    <!-- Architecture folder name used under deps\lib\ and deps\bin\. -->
    <_WinUAEDepsArch Condition="'$(Platform)' == 'Win32'">x86</_WinUAEDepsArch>
    <_WinUAEDepsArch Condition="'$(Platform)' == 'x64'">x64</_WinUAEDepsArch>
    <_WinUAEDepsArch Condition="'$(Platform)' == 'ARM64'">arm64</_WinUAEDepsArch>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OutDir)' == 'd:\amiga\' or '$(MSBuildProjectName)' == 'winuae_msvc'">
    <OutDir>$(WinUAEOutDir)</OutDir>
  </PropertyGroup>

  <PropertyGroup>
    <OutDir>$([System.Text.RegularExpressions.Regex]::Replace('$(OutDir)', '$(_WinUAEDevPattern)', '$(WinUAEDepsDir)'))</OutDir>
    <IncludePath>$([System.Text.RegularExpressions.Regex]::Replace('$(IncludePath)', '$(_WinUAEDevPattern)', '$(WinUAEDepsDir)'))</IncludePath>
    <LibraryPath>$([System.Text.RegularExpressions.Regex]::Replace('$(LibraryPath)', '$(_WinUAEDevPattern)', '$(WinUAEDepsDir)'))</LibraryPath>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <Link>
      <AdditionalLibraryDirectories>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace('%(Link.AdditionalLibraryDirectories)', '$(_WinUAEDevPattern)', '$(WinUAEDepsDir)'))))</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>

  <!--
    Portable mode: when winuae.ini exists next to the executable, WinUAE keeps
    its settings in that file instead of the registry and uses the executable
    folder as its data folder (relative paths). The file is shared by
    winuae.exe, winuae64.exe and winuaearm64.exe and is never overwritten.
  -->
  <Target Name="WinUAEEnsurePortableIni" AfterTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'winuae_msvc' and !Exists('$(OutDir)winuae.ini')">
    <Touch Files="$(OutDir)winuae.ini" AlwaysCreate="true" />
  </Target>

  <!--
    Code generators: upstream's ARM64 configurations of build68k, genlinetoscr,
    genblitter, gencpu and gencomp are copies of the Win32 ones. They link with
    /MACHINE:I386 and without ASLR (not allowed for ARM64), and put their object
    files into the .\Release\ folder the Win32 build also uses. Fix that for a
    native ARM64 build; generators.proj builds them in the required order.
  -->
  <PropertyGroup>
    <_WinUAEIsGenerator Condition="'$(MSBuildProjectName)' == 'build68k_msvc' or '$(MSBuildProjectName)' == 'genlinetoscr_msvc' or '$(MSBuildProjectName)' == 'genblitter_msvc' or '$(MSBuildProjectName)' == 'gencpu_msvc' or '$(MSBuildProjectName)' == 'gencomp_msvc'">true</_WinUAEIsGenerator>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(_WinUAEIsGenerator)' == 'true' and '$(Platform)' == 'ARM64'">
    <ClCompile>
      <ObjectFileName>$(IntDir)</ObjectFileName>
      <ProgramDataBaseFileName>$(IntDir)</ProgramDataBaseFileName>
      <PrecompiledHeaderOutputFile>$(IntDir)$(MSBuildProjectName).pch</PrecompiledHeaderOutputFile>
      <AssemblerListingLocation>$(IntDir)</AssemblerListingLocation>
    </ClCompile>
    <Link>
      <AdditionalOptions>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace('%(Link.AdditionalOptions)', '(?i)/MACHINE:I386', ''))))</AdditionalOptions>
      <RandomizedBaseAddress>true</RandomizedBaseAddress>
      <ProgramDatabaseFile>$(IntDir)$(MSBuildProjectName).pdb</ProgramDatabaseFile>
    </Link>
  </ItemDefinitionGroup>

  <!--
    CPU tester (cputest\readme.txt): its CPU core comes from gencpu built with
    CPU_TESTER set to 1, which upstream does by editing gencpu.cpp. With
    WinUAECpuTester=true (generators.proj, target CpuTester), gencpu is built
    from a copy of gencpu.cpp with that line changed, in its own IntDir.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'gencpu_msvc' and '$(WinUAECpuTester)' == 'true'">
    <IntDir>$(Platform)\$(Configuration)\cputester\</IntDir>
    <_WinUAEGencpuSource>$(MSBuildProjectDirectory)\..\..\gencpu.cpp</_WinUAEGencpuSource>
    <_WinUAEGencpuTesterSource>$(MSBuildProjectDirectory)\$(IntDir)gencpu.cpp</_WinUAEGencpuTesterSource>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'gencpu_msvc' and '$(WinUAECpuTester)' == 'true'">
    <ClCompile Remove="..\..\gencpu.cpp" />
    <ClCompile Include="$(_WinUAEGencpuTesterSource)" />
  </ItemGroup>
  <Target Name="WinUAEMakeGencpuTesterSource" BeforeTargets="ClCompile"
          Condition="'$(MSBuildProjectName)' == 'gencpu_msvc' and '$(WinUAECpuTester)' == 'true'">
    <PropertyGroup>
      <_WinUAEGencpuText>$([System.IO.File]::ReadAllText('$(_WinUAEGencpuSource)'))</_WinUAEGencpuText>
    </PropertyGroup>
    <Error Condition="!$(_WinUAEGencpuText.Contains('#define CPU_TESTER 0'))"
           Text="gencpu.cpp no longer contains '#define CPU_TESTER 0'." />
    <WriteLinesToFile File="$(_WinUAEGencpuTesterSource)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="$([MSBuild]::Escape($(_WinUAEGencpuText.Replace('#define CPU_TESTER 0', '#define CPU_TESTER 1'))))" />
  </Target>

  <!-- cputestgen's ARM64 configurations search the x64 VC and SDK libraries. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'cputester' and '$(Platform)' == 'ARM64'">
    <LibraryPath>$(WinUAEDepsDir)lib\arm64;$(VC_LibraryPath_ARM64);$(WindowsSDK_LibraryPath_ARM64)</LibraryPath>
  </PropertyGroup>

  <!--
    Optional ARM64 libraries built by deps-build\build-deps.ps1: when one is
    present, link it and define ARM64_WITH_*, which keeps od-win32\sysconfig.h
    from disabling the feature on ARM64.
  -->
  <ItemDefinitionGroup Condition="'$(MSBuildProjectName)' == 'winuae_msvc' and '$(Platform)' == 'ARM64' and Exists('$(WinUAEDepsDir)lib\arm64\enet.lib')">
    <ClCompile>
      <PreprocessorDefinitions>ARM64_WITH_ENET;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>enet.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(MSBuildProjectName)' == 'winuae_msvc' and '$(Platform)' == 'ARM64' and Exists('$(WinUAEDepsDir)lib\arm64\OpenAL32.lib')">
    <ClCompile>
      <PreprocessorDefinitions>ARM64_WITH_OPENAL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>OpenAL32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <DelayLoadDLLs>OpenAL32.dll;%(DelayLoadDLLs)</DelayLoadDLLs>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(MSBuildProjectName)' == 'winuae_msvc' and '$(Platform)' == 'ARM64' and Exists('$(WinUAEDepsDir)lib\arm64\luastatic.lib')">
    <ClCompile>
      <PreprocessorDefinitions>ARM64_WITH_LUA;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>luastatic.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <!--
    Runtime DLLs built by deps-build\build-deps.ps1 (deps\bin\<arch>\, with
    plugins in its plugins\ subfolder) are copied next to the executable.
  -->
  <PropertyGroup>
    <_WinUAEDepsBinDir>$(WinUAEDepsDir)bin\$(_WinUAEDepsArch)\</_WinUAEDepsBinDir>
  </PropertyGroup>

  <Target Name="WinUAECopyRuntimeDlls" AfterTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'winuae_msvc' and '$(_WinUAEDepsArch)' != '' and Exists('$(_WinUAEDepsBinDir)')">
    <ItemGroup>
      <_WinUAERuntimeFile Include="$(_WinUAEDepsBinDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinUAERuntimeFile)"
          DestinationFiles="@(_WinUAERuntimeFile->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
